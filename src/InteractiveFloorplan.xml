<?xml version="1.0" encoding="utf-8" ?>
<widget
    id="auraq.interactivefloorplan.InteractiveFloorplan"
    pluginWidget="true"
    needsEntityContext="true"
    offlineCapable="true"
    supportedPlatform="Web"
    xmlns="http://www.mendix.com/widget/1.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd"
>
    <name>Interactive Floorplan</name>
    <description>Render interactive floorplan elements on a canvas</description>
    <icon />
    <properties>

        <!-- TAB 1: General -->
        <propertyGroup caption="General">
            <propertyGroup caption="Canvas">
                <property key="backgroundColour" type="string">
                    <caption>Background Colour</caption>
                    <description>The colour of the canvas</description>
                </property>
                <property key="initialZoom" type="attribute" required="false">
                    <caption>Initial Zoom</caption>
                    <description>Value indicating the initial zoom level of the canvas</description>
                    <attributeTypes>
                        <attributeType name="Decimal" />
                        <attributeType name="Integer" />
                        <attributeType name="Long" />
                    </attributeTypes>
                </property>
                <property key="backgroundImage" type="image" required="false">
                    <caption>Background Image</caption>
                    <description></description>
                </property>
                <property key="backgroundImageWidth" type="attribute" required="false">
                    <caption>Background Image Width</caption>
                    <description>Width of the background image to fit the canvas when auto zoom is enabled</description>
                    <attributeTypes>
                        <attributeType name="Decimal" />
                        <attributeType name="Integer" />
                        <attributeType name="Long" />
                    </attributeTypes>
                </property>
                <property key="backgroundImageHeight" type="attribute" required="false">
                    <caption>Background Image Height</caption>
                    <description>Height of the background image to fit the canvas when auto zoom is enabled</description>
                    <attributeTypes>
                        <attributeType name="Decimal" />
                        <attributeType name="Integer" />
                        <attributeType name="Long" />
                    </attributeTypes>
                </property>
                <property key="autoInitialZoom" type="boolean" defaultValue="false">
                    <caption>Auto Initial Zoom</caption>
                    <description>If enabled, the canvas will auto-scale to fit the provided background image width and height.</description>
                </property>
                <property key="readOnly" type="expression" defaultValue="true">
                    <caption>Read Only?</caption>
                    <description>Disable movement while still allowing selection.</description>
                    <returnType type="Boolean" />
                </property>
                <property key="initialLeft" type="attribute" required="false">
                    <caption>Initial Left</caption>
                    <description>Value indicating the initial left position of the canvas</description>
                    <attributeTypes>
                        <attributeType name="Decimal" />
                        <attributeType name="Integer" />
                        <attributeType name="Long" />
                    </attributeTypes>
                </property>
                <property key="initialTop" type="attribute" required="false">
                    <caption>Initial Top</caption>
                    <description>Value indicating the initial top position of the canvas</description>
                    <attributeTypes>
                        <attributeType name="Decimal" />
                        <attributeType name="Integer" />
                        <attributeType name="Long" />
                    </attributeTypes>
                </property>
                <property key="multiselect" type="boolean" defaultValue="false">
                    <caption>Multi-Select</caption>
                    <description />
                </property>
                <property key="groupCategoriesJSON" type="attribute">
                    <caption>Group Categories JSON</caption>
                    <description>JSON object holding named sets of FabricJS properties to style groups according state (selected/deselected). JSON structure should follow: 
{ &lt;CategoryName&gt;: { &lt;StatusName&gt;: { "selected": ..., "deselected": ... } } }</description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
                <property key="loadingContent" type="widgets" required="false">
                    <caption>Loading Content</caption>
                    <description></description>
                </property>
            </propertyGroup>
        </propertyGroup>

        <!-- TAB 2: Groups -->
        <propertyGroup caption="Groups">
            <propertyGroup caption="Data source">
                <property key="data" type="datasource" isList="true" required="true">
                    <caption>Data Source</caption>
                    <description />
                </property>
            </propertyGroup>
            <propertyGroup caption="Group attributes">
                <property key="groupId" type="attribute" dataSource="data">
                    <caption>Group ID</caption>
                    <description>An identifier for the group</description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
                <property key="groupCategory" type="attribute" dataSource="data">
                    <caption>Group Category</caption>
                    <description>Category key name from 'Canvas &gt; Group Categories JSON' JSON object.</description>
                    <attributeTypes>
                        <attributeType name="String" />
                        <attributeType name="Enum" />
                    </attributeTypes>
                </property>
                <property key="groupStatus" type="attribute" dataSource="data">
                    <caption>Group Status</caption>
                    <description>Status key name from 'Canvas &gt; Group Categories JSON' JSON object.</description>
                    <attributeTypes>
                        <attributeType name="String" />
                        <attributeType name="Enum" />
                    </attributeTypes>
                </property>
                <property key="groupIsSelectable" type="attribute" dataSource="data">
                    <caption>Is Selectable</caption>
                    <description>Whether a group can be selected</description>
                    <attributeTypes>
                        <attributeType name="Boolean" />
                    </attributeTypes>
                </property>
                <property key="groupPropertiesJSON" type="attribute" dataSource="data">
                    <caption>Group Properties JSON</caption>
                    <description>JSON object holding named sets of FabricJS properties to style group</description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
                <property key="groupElementsJSON" type="attribute" dataSource="data">
                    <caption>Group Elements JSON</caption>
                    <description>JSON array holding all FabricJS elements, for supported element types: path, line, rect, triangle, image</description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
            </propertyGroup>
            <propertyGroup caption="Tooltips">
                <property key="enableTooltips" type="boolean" defaultValue="true">
                    <caption>Enable Tooltips</caption>
                    <description>Show a tooltip when hovering groups on the canvas.</description>
                </property>
                <property key="groupTooltipOn" type="expression" defaultValue="true" dataSource="data">
                    <caption>Show Tooltip?</caption>
                    <description></description>
                    <returnType type="Boolean" />
                </property>
                <property key="tooltipContent" type="widgets" required="false" dataSource="data">
                    <caption>Group Tooltip Content</caption>
                    <description></description>
                </property>
            </propertyGroup>
        </propertyGroup>

        <!-- TAB 3: Events -->
        <propertyGroup caption="Events">
           <propertyGroup caption="Selection">
                <property key="onSelection" type="action" dataSource="data">
                    <caption>On Selection</caption>
                    <description>Action to be performed when a group is selected</description>
                </property>
                <property key="onDeselection" type="action" dataSource="data">
                    <caption>On Deselection</caption>
                    <description>Action to be performed when a group is deselected</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Multi-selection">
                <property key="selectedGroups" type="attribute" required="false">
                    <caption>Selected Groups</caption>
                    <description>Attribute to store CSV of selected group ids</description>
                    <attributeTypes>
                        <attributeType name="String"/>
                    </attributeTypes>
                </property>
                <property key="onMultiSelectionEnd" type="action">
                    <caption>On Multi Selection End</caption>
                    <description>Action to be performed when multiple groups have been selected</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Item move">
                <property key="movedItemX" type="attribute" required="false">
                    <caption>Moved X</caption>
                    <description>Attribute to store new X position</description>
                    <attributeTypes>
                        <attributeType name="String"/>
                        <attributeType name="Decimal"/>
                        <attributeType name="Integer"/>
                        <attributeType name="Long"/>
                    </attributeTypes>
                </property>
                <property key="movedItemY" type="attribute" required="false">
                    <caption>Moved Y</caption>
                    <description>Attribute to store new Y position</description>
                    <attributeTypes>
                        <attributeType name="String"/>
                        <attributeType name="Decimal"/>
                        <attributeType name="Integer"/>
                        <attributeType name="Long"/>
                    </attributeTypes>
                </property>
                <property key="onItemMoved" type="action" dataSource="data">
                    <caption>On Item Moved</caption>
                    <description>Called when an item is dragged to a new position</description>
                </property>
            </propertyGroup>
            <propertyGroup caption="Path drawing">
                <property key="pathVertices" type="attribute" required="false">
                    <caption>Path Vertices</caption>
                    <description>SVG path string of drawn path</description>
                    <attributeTypes>
                        <attributeType name="String"/>
                    </attributeTypes>
                </property>
                <property key="onPathCreated" type="action">
                    <caption>On Path Created</caption>
                    <description>Called when a path is completed</description>
                </property>
            </propertyGroup>
        </propertyGroup>

    </properties>
</widget>